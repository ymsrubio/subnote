		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.2.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7",
		"vitest": "^4.1.3"
	}
